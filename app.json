{
  "expo": {
    "name": "投资日志",
    "slug": "investment-journal",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#f5f1e8"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "buildNumber": "11",
      "bundleIdentifier": "com.liubiedi.investmentjournal",
      "deploymentTarget": "16.0",
      "infoPlist": {
        "NSCalendarsUsageDescription": "Allow 投资日志 to access your calendar to create trade reminders.",
        "NSCalendarsFullAccessUsageDescription": "Allow 投资日志 to access your calendar to create trade reminders.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.liubiedi.investmentjournal",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#f5f1e8"
      },
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR"
      ]
    },
    "plugins": [
      "expo-font",
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      [
        "expo-calendar",
        {
          "calendarPermission": "Allow 投资日志 to access your calendar to create trade reminders."
        }
      ],
      "expo-background-task"
    ],
    "extra": {
      "eas": {
        "projectId": "a3eb9226-f124-4331-983a-4ac403d8c7a5"
      }
    },
    "owner": "liubiedi"
  }
}
