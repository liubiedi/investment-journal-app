{
  "name": "investment-journal-app",
  "version": "1.0.0",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "prebuild": "expo prebuild",
    "build:apk": "eas build -p android --profile preview",
    "postinstall": "node scripts/patch-voice-gradle.js",
    "test": "jest"
  },
  "jest": {
    "preset": "jest-expo",
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg|lucide-react-native)"
    ],
    "moduleNameMapper": {
      "^expo-sqlite$": "<rootDir>/__mocks__/expo-sqlite.js",
      "^expo-secure-store$": "<rootDir>/__mocks__/expo-secure-store.js",
      "^expo-clipboard$": "<rootDir>/__mocks__/expo-clipboard.js",
      "^expo-calendar$": "<rootDir>/__mocks__/expo-calendar.js",
      "^expo-print$": "<rootDir>/__mocks__/expo-print.js",
      "^expo-sharing$": "<rootDir>/__mocks__/expo-sharing.js",
      "^@react-native-voice/voice$": "<rootDir>/__mocks__/@react-native-voice/voice.js"
    }
  },
  "dependencies": {
    "@expo-google-fonts/fraunces": "^0.2.3",
    "@expo-google-fonts/jetbrains-mono": "^0.2.3",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-native-voice/voice": "^3.2.4",
    "@react-navigation/bottom-tabs": "^6.6.0",
    "@react-navigation/native": "^6.1.18",
    "@react-navigation/native-stack": "^6.10.0",
    "expo": "~54.0.0",
    "expo-calendar": "~15.0.8",
    "expo-clipboard": "~7.0.0",
    "expo-file-system": "~19.0.22",
    "expo-font": "~14.0.11",
    "expo-print": "~15.0.8",
    "expo-secure-store": "~15.0.8",
    "expo-sharing": "~14.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "~3.0.9",
    "lucide-react-native": "^1.14.0",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-zip-archive": "7.0.2"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@expo/config-plugins": "~54.0.4",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^13.3.3",
    "babel-preset-expo": "~54.0.0",
    "jest": "^29.7.0",
    "jest-expo": "~54.0.0"
  },
  "private": true
}
